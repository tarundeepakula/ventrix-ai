# Copy this file to ".env" and fill in your own values.
# Never share or upload your real .env file.

# development while building on your computer, production when live
NODE_ENV=development

# Port the server runs on, and the address you open in the browser
PORT=4000
APP_URL=http://localhost:4000

# PostgreSQL connection string
# Copy it from Neon: your project > Connect > connection string (pooling OFF)
DATABASE_URL=PASTE_YOUR_NEON_CONNECTION_STRING_HERE

# Email (for password reset links).
# Leave SMTP_HOST empty while developing: emails are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ventrix AI <no-reply@ventrix.ai>"
